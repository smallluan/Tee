{
  "name": "tee-framework",
  "version": "0.8.2",
  "description": "Tee — a point-to-point reactive frontend framework driven by bidirectional DOM maps, not a virtual DOM.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-tee": "./scripts/create-tee.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./create": "./scripts/create-tee.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "editor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --port 43151 --host 0.0.0.0",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json --noCheck",
    "build:demo": "vite build",
    "preview": "vite preview --port 43151 --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "create": "node scripts/create-tee.mjs",
    "bench:install": "node scripts/install-js-benchmark.mjs",
    "prepublishOnly": "vitest run && npm run build"
  },
  "peerDependencies": {
    "less": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "less": {
      "optional": true
    }
  },
  "keywords": [
    "tee",
    "reactive",
    "framework",
    "bidirectional-map",
    "no-virtual-dom"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "^20.14.3",
    "less": "^4.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
