{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "tee": ["./src/tee/index.ts"],
      "tee-framework": ["./src/tee/index.ts"],
      "tee-framework/plugin": ["./src/tee/plugin.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "tests"]
}
