import { setup, computed } from "tee-framework";
import "./App.less";

export default setup((self) => {
  self.title = "新的 Tee 应用";
  self.guest = "";
  self.count = 0;
  self.doubled = computed(() => Number(self.count) * 2);

  return (
    <main class="page">
      <p class="eyebrow">Tee · no virtual DOM</p>
      <h1>{self.title}</h1>
      <p class="lede">函数返回真实 DOM。Less 从旁边引进来，不写在这个文件里。</p>

      <label>
        名字
        <input t-model:trim="guest" placeholder="访客" />
      </label>

      <p class="hello">你好，{self.guest || "访客"}</p>

      <div class="row">
        <button t-on:click={() => (self.count = Number(self.count) + 1)}>count {self.count}</button>
        <span class="chip">{self.doubled}</span>
      </div>

      <p t-if={self.count === 0} class="empty">
        还没点过。
      </p>
      <p t-else-if={Number(self.count) < 5} class="ok">
        继续点，{self.guest || "访客"}。
      </p>
      <p t-else class="ok">
        已经 {self.count} 次了。
      </p>
    </main>
  );
});
