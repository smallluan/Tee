  font-size: 2.4rem;
  margin: 0 0 0.5rem;
}

.lede,
.empty,
.ok,
.hello {
  color: lighten(@ink, 28%);
}

label {
  display: grid;
  gap: 0.35rem;
  margin: 1.5rem 0 0.75rem;
  font-size: 0.85rem;
}

input,
button {
  font: inherit;
}

input {
  padding: 0.55rem 0.7rem;
  border: 1px solid fade(@ink, 16%);
  border-radius: 0.55rem;
  background: white;
}

.row {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  margin: 1rem 0;
}

button {
  background: @ink;
