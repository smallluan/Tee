<template>
  <main class="page">
    <p class="eyebrow">Tee · no virtual DOM</p>
    <h1>{{ title }}</h1>
    <p class="lede">改输入只 patch 真实文本节点。Less 变量在右边的芯片上。</p>

    <label>
      名字
      <input t-model.trim="guest" placeholder="访客" />
    </label>

    <p class="hello">你好，{{ guest || "访客" }}</p>

    <div class="row">
      <button t-on:click="count = count + 1">count {{ count }}</button>
      <span class="chip">{{ doubled }}</span>
    </div>

    <p t-if="count === 0" class="empty">还没点过。</p>
    <p t-else-if="count < 5" class="ok">继续点，{{ guest || "访客" }}。</p>
    <p t-else class="ok">已经 {{ count }} 次了。</p>
  </main>
</template>

<script lang="ts">
import { setup, computed } from "tee-framework";

export default setup((self) => {
  self.title = "新的 Tee 应用";
  self.guest = "";
  self.count = 0;
  self.doubled = computed(() => Number(self.count) * 2);
});
</script>

<style lang="less" scoped>
