{
  "name": "Tee",
  "scopeName": "source.tee",
  "fileTypes": ["tee"],
  "patterns": [
    { "include": "#template" },
    { "include": "#script" },
    { "include": "#style-less" },
    { "include": "#style-scss" },
    { "include": "#style-css" }
  ],
  "repository": {
    "template": {
      "begin": "(<)(template)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.template.tee" }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.template.tee" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "text.html.tee",
      "patterns": [
        { "include": "#tag-open-rest" },
        { "include": "#template-body" }
      ]
    },
    "template-body": {
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#html-comment" },
        { "include": "#end-tag" },
        { "include": "#start-tag" }
      ]
    },
    "html-comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.html"
    },
    "tag-open-rest": {
      "begin": "\\G",
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#directive-attr-dquote" },
        { "include": "#directive-attr-squote" },
        { "include": "#directive-bare" },
        { "include": "#html-attr-dquote" },
        { "include": "#html-attr-squote" },
        { "include": "#html-attr-bare" }
      ]
    },
    "end-tag": {
      "match": "(</)([a-zA-Z][\\w:-]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      }
    },
    "start-tag": {
      "begin": "(<)([a-zA-Z][\\w:-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(/?)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" },
        "2": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.tag.inline.tee",
      "patterns": [
        { "include": "#directive-attr-dquote" },
        { "include": "#directive-attr-squote" },
        { "include": "#directive-bare" },
        { "include": "#html-attr-dquote" },
        { "include": "#html-attr-squote" },
        { "include": "#html-attr-bare" }
      ]
    },
    "directive-attr-dquote": {
      "begin": "\\b(t-[\\w.:-]+)(\\s*=\\s*)(\")",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.directive.tee" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "punctuation.definition.string.begin.html" }
      },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
      "name": "meta.directive.tee",
      "contentName": "source.ts.embedded.expression.tee",
      "patterns": [{ "include": "#tee-expr" }]
    },
    "directive-attr-squote": {
      "begin": "\\b(t-[\\w.:-]+)(\\s*=\\s*)(')",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.directive.tee" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "punctuation.definition.string.begin.html" }
      },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
      "name": "meta.directive.tee",
      "contentName": "source.ts.embedded.expression.tee",
      "patterns": [{ "include": "#tee-expr" }]
    },
    "directive-bare": {
      "match": "\\b(t-(?:else|pre|once|cloak))\\b",
      "name": "entity.other.attribute-name.directive.tee"
    },
    "html-attr-dquote": {
      "begin": "\\b([:@]?[A-Za-z_:][\\w:.-]*)(\\s*=\\s*)(\")",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.html" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "punctuation.definition.string.begin.html" }
      },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
      "name": "meta.attribute-with-value.html",
      "patterns": [{ "include": "#interpolation" }]
    },
    "html-attr-squote": {
      "begin": "\\b([:@]?[A-Za-z_:][\\w:.-]*)(\\s*=\\s*)(')",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.html" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "punctuation.definition.string.begin.html" }
      },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
      "patterns": [{ "include": "#interpolation" }]
    },
    "html-attr-bare": {
      "match": "\\b([A-Za-z_:][\\w:.-]*)",
      "name": "entity.other.attribute-name.html"
    },
    "interpolation": {
      "begin": "\\{\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.tee" } },
      "end": "\\}\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.tee" } },
      "name": "meta.interpolation.tee",
      "contentName": "source.ts.embedded.expression.tee",
      "patterns": [{ "include": "#tee-expr" }]
    },
    "script": {
      "begin": "(<)(script)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.tee" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.tee" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.embedded.block.script.tee",
      "patterns": [
        { "include": "#tag-open-rest" },
        {
          "begin": "(?<=>)",
          "end": "(?=</script>)",
          "contentName": "source.ts",
          "name": "source.ts.embedded.tee",
          "patterns": [{ "include": "source.ts" }, { "include": "#tee-expr" }]
        }
      ]
    },
    "style-less": {
      "begin": "(<)(style)\\b(?=[^>]*lang\\s*=\\s*['\"]less['\"])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.tee" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.tee" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.embedded.block.style.less.tee",
      "patterns": [
        { "include": "#tag-open-rest" },
        {
          "begin": "(?<=>)",
          "end": "(?=</style>)",
          "contentName": "source.css.less",
          "name": "source.css.less.embedded.tee",
          "patterns": [{ "include": "source.css.less" }, { "include": "#less-lite" }]
        }
      ]
    },
    "style-scss": {
      "begin": "(<)(style)\\b(?=[^>]*lang\\s*=\\s*['\"]s[ac]ss['\"])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.tee" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.tee" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.embedded.block.style.scss.tee",
      "patterns": [
        { "include": "#tag-open-rest" },
        {
          "begin": "(?<=>)",
          "end": "(?=</style>)",
          "contentName": "source.css.scss",
          "name": "source.css.scss.embedded.tee",
          "patterns": [{ "include": "source.css.scss" }, { "include": "#less-lite" }]
        }
      ]
    },
    "style-css": {
      "begin": "(<)(style)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.tee" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.tee" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.embedded.block.style.css.tee",
      "patterns": [
        { "include": "#tag-open-rest" },
        {
          "begin": "(?<=>)",
          "end": "(?=</style>)",
          "contentName": "source.css",
          "name": "source.css.embedded.tee",
          "patterns": [{ "include": "source.css" }, { "include": "#less-lite" }]
        }
      ]
    },
    "tee-expr": {
      "patterns": [
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.tee" },
        { "match": "//.*$", "name": "comment.line.double-slash.tee" },
        { "match": "'[^']*'", "name": "string.quoted.single.tee" },
        { "match": "\"[^\"]*\"", "name": "string.quoted.double.tee" },
        { "match": "`[^`]*`", "name": "string.quoted.other.tee" },
        { "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b", "name": "constant.language.tee" },
        { "match": "\\b(new|typeof|void|in|of|instanceof|return|await|delete)\\b", "name": "keyword.operator.tee" },
        { "match": "=>", "name": "storage.type.function.arrow.tee" },
        { "match": "===|!==|==|!=|<=|>=|&&|\\|\\||\\?\\?", "name": "keyword.operator.tee" },
        { "match": "[+\\-*/%]=?", "name": "keyword.operator.tee" },
        { "match": "[<>]=?", "name": "keyword.operator.relational.tee" },
        { "match": "\\b\\d+(\\.\\d+)?\\b", "name": "constant.numeric.tee" },
        { "match": "\\b(self|this)\\b", "name": "variable.language.tee" },
        { "match": "\\b[A-Za-z_$][\\w$]*\\b", "name": "variable.other.tee" },
        { "match": "[()[\\]{},.;]", "name": "punctuation.definition.tee" }
      ]
    },
    "less-lite": {
      "patterns": [
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.css" },
        { "match": "//.*$", "name": "comment.line.double-slash.less" },
        { "match": "#[0-9A-Fa-f]{3,8}\\b", "name": "constant.other.color.rgb-value.css" },
        { "match": "@[A-Za-z_][\\w-]*", "name": "variable.other.less" },
        {
          "match": "\\b(lighten|darken|fade|fadein|fadeout|saturate|desaturate|spin|mix|contrast)\\s*(?=\\()",
          "name": "support.function.less"
        },
        {
          "match": "([a-zA-Z_-][\\w-]*)(\\s*)(:)",
          "captures": {
            "1": { "name": "support.type.property-name.css" },
            "2": { "name": "" },
            "3": { "name": "punctuation.separator.key-value.css" }
          }
        },
        { "match": "\\b\\d+(\\.\\d+)?(px|em|rem|vh|vw|%|s|ms)?\\b", "name": "constant.numeric.css" },
        {
          "match": "\\b(solid|none|auto|inherit|center|flex|grid|block|inline|white|black|uppercase)\\b",
          "name": "support.constant.property-value.css"
        },
        { "match": "\"[^\"]*\"", "name": "string.quoted.double.css" },
        { "match": "'[^']*'", "name": "string.quoted.single.css" },
        { "match": "[.#][A-Za-z_][\\w-]*", "name": "entity.other.attribute-name.class.css" },
        { "match": "\\b[a-z][a-z0-9]*\\b(?=\\s*\\{)", "name": "entity.name.tag.css" }
      ]
    }
  }
}
