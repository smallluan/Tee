{
  "tee-if": {
    "prefix": "t-if",
    "body": "t-if={$1}",
    "description": "Conditionally mount this node."
  },
  "tee-else-if": {
    "prefix": "t-else-if",
    "body": "t-else-if={$1}",
    "description": "Else-if branch of a t-if chain."
  },
  "tee-repeat": {
    "prefix": "t-repeat",
    "body": "t-repeat={$1}",
    "description": "Repeat this node from a list getter."
  },
  "tee-for": {
    "prefix": "For",
    "body": [
      "<For each={self.$1} by=\"id\">",
      "  {(item, index) => (",
      "    <li>{item.$2}</li>",
      "  )}",
      "</For>"
    ],
    "description": "Tee list. Import For from tee-framework."
  },
  "tee-on-click": {
    "prefix": "t-on:click",
    "body": "t-on:click={() => $1}",
    "description": "Click handler."
  },
  "tee-on-input": {
    "prefix": "t-on:input",
    "body": "t-on:input={(e) => $1}",
    "description": "Input handler."
  },
  "tee-on-compositionend": {
    "prefix": "t-on:compositionend",
    "body": "t-on:compositionend={(e) => $1}",
    "description": "IME composition end."
  },
  "tee-on-dblclick": {
    "prefix": "t-on:dblclick",
    "body": "t-on:dblclick={() => $1}",
    "description": "Double-click handler."
  },
  "tee-on-dragstart": {
    "prefix": "t-on:dragstart",
    "body": "t-on:dragstart={(e) => $1}",
    "description": "Drag start handler."
  },
  "tee-model": {
    "prefix": "t-model",
    "body": "t-model=\"$1\"",
    "description": "Two-way bind an input."
  },
  "tee-setup": {
    "prefix": "setup",
    "body": [
      "import { setup, computed } from \"tee-framework\";",
      "import \"./$1.less\";",
      "",
      "export default setup((self) => {",
      "  $0",
      "  return (",
      "    <main></main>",
      "  );",
      "});"
    ],
    "description": "Tee setup() that returns real DOM."
  }
}
