{
  "name": "tee-language",
  "displayName": "Tee",
  "description": "Language support for Tee `.tee` single-file components: TypeScript in <script>, expressions in {{ }} and t-* directives.",
  "version": "0.8.3",
  "publisher": "tee",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:tee"],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "tee",
        "aliases": ["Tee", "tee"],
        "extensions": [".tee"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tee",
        "scopeName": "source.tee",
        "path": "./syntaxes/tee.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.js": "javascript",
          "source.css": "css",
          "source.less": "less",
          "source.css.scss": "scss",
          "text.html.tee": "html"
        }
      }
    ]
  }
}
