{
  "name": "tee-language",
  "displayName": "Tee",
  "description": "Syntax, IntelliSense, and file icon for Tee `.tee` single-file components.",
  "version": "0.8.8",
  "publisher": "tee",
  "icon": "icons/tee.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:tee", "workspaceContains:**/*.tee"],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "tee",
        "aliases": ["Tee", "tee"],
        "extensions": [".tee"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tee-file-light.svg",
          "dark": "./icons/tee-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tee",
        "scopeName": "source.tee",
        "path": "./syntaxes/tee.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.js": "javascript",
          "source.css": "css",
          "source.less": "less",
          "source.css.scss": "scss",
          "text.html.tee": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "tee",
        "path": "./snippets/tee.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.tee": "tee"
      },
      "[tee]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.wordBasedSuggestions": "off"
      },
      "emmet.includeLanguages": {
        "tee": "html"
      }
    }
  }
}
