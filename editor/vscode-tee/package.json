{
  "name": "tee-language",
  "displayName": "Tee",
  "description": "TSX highlighting, IntelliSense, and file icon for Tee `.tee` modules.",
  "version": "0.9.5",
  "publisher": "tee",
  "icon": "icons/tee.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:tee", "workspaceContains:**/*.tee"],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "tee",
        "aliases": ["Tee", "tee"],
        "extensions": [".tee"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tee-file-light.svg",
          "dark": "./icons/tee-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tee",
        "scopeName": "source.tee",
        "path": "./syntaxes/tee.tmLanguage.json",
        "embeddedLanguages": {
          "source.tsx": "typescriptreact",
          "source.ts": "typescript"
        }
      }
    ],
    "snippets": [
      {
        "language": "tee",
        "path": "./snippets/tee.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.tee": "tee"
      },
      "[tee]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.wordBasedSuggestions": "off"
      },
      "emmet.includeLanguages": {
        "tee": "typescriptreact"
      }
    }
  }
}
