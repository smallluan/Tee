{
  "comments": {
    "blockComment": ["<!--", "-->"],
    "lineComment": "//"
  },
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"],
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{{", "close": "}}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'" },
    { "open": "\"", "close": "\"" },
    { "open": "<!--", "close": "-->" }
  ],
  "surroundingPairs": [
    { "open": "'", "close": "'" },
    { "open": "\"", "close": "\"" },
    { "open": "{{", "close": "}}" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">" }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\%\\^\\&\\*\\(\\)\\=\\+\\[\\]\\{\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)",
  "folding": {
    "markers": {
      "start": "^\\s*<(template|script|style)\\b",
      "end": "^\\s*</(template|script|style)>"
    }
  }
}
